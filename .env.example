# Copy to .env.local for development. On Vercel, add these in Project Settings → Environment Variables.

# Required
ANTHROPIC_API_KEY=

# Required in production (rate limiting). Without them, production refuses all model calls.
# Create a free database at upstash.com → Redis → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Any long random string. Used to hash visitor IPs (raw IPs are never stored).
IP_HASH_SALT=

# Optional limits (defaults shown)
PER_IP_DAILY_LIMIT=10
GLOBAL_DAILY_LIMIT=200
MAX_QUESTION_CHARS=500
MAX_OUTPUT_TOKENS=600
ANTHROPIC_MODEL=claude-haiku-5-5
